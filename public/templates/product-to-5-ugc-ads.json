  "wires": [
    {
      "id": "w1",
      "from": "product",
      "fromPort": "out",
      "to": "scripts",
      "toPort": "product"
    },
    {
      "id": "w2",
      "from": "scripts",
      "fromPort": "all",
      "to": "voice",
      "toPort": "script"
    },
    {
      "id": "w3",
      "from": "scripts",
      "fromPort": "all",
      "to": "broll",
      "toPort": "script"
    },
    {
      "id": "w4",
      "from": "character",
