      "kind": "bank",
      "label": "Your Character",
      "x": 0,
      "y": 240,
      "settings": {
        "bank": "models"
      },
      "source": "bank",
      "field": true
    },
    {
      "id": "scripts",
      "kind": "scripts",
      "x": 360,
      "y": 0,
      "settings": {
        "mode": "write",
        "writeFormat": "script",
        "writeStyle": "pas",
        "writeLength": 30,
        "remixLength": "default",
        "hookCategory": "auto",
        "hookCount": 10,
        "variationCount": 5,
        "brief": "",
        "source": "",
        "additionalContext": ""
      },
      "source": "generate",
      "review": true
    },
    {
      "id": "voice",
      "kind": "voice",
      "x": 740,
      "y": 0,
      "settings": {
        "voiceId": "Puck",
        "voiceName": "Puck",
        "gender": "Male",
        "style": "Empathetic",
        "pace": "Rapid Fire",
        "accent": "Neutral",
        "temperature": 1,
        "scene": "",
        "sampleContext": "Creator talks at a normal tempo."
      },
      "source": "generate"
    },
    {
      "id": "broll",
      "kind": "broll",
      "x": 740,
      "y": 300,
      "settings": {
        "delivery": "silent",
        "aspectRatio": "9:16",
        "animate": true,
        "takes": 1,
        "context": "",
        "styleId": "ugc"
      },
      "source": "generate",
      "review": true
    },
    {
      "id": "edit",
      "kind": "edit",
      "x": 1120,
      "y": 160,
      "settings": {},
      "source": "generate"
    },
    {
      "id": "note",
      "kind": "note",
      "x": 0,
      "y": 480,
      "settings": {
        "text": "Pick your product and your character, then Test With 1 before the full run. Scripts pauses so you can keep only the takes you like, and B-Roll pauses after the stills so you only pay to animate the good ones."
      }
    }
